{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "site": "novetec",
    "public": ".",
    "ignore": [
      "firebase/**",
      "firebase.json",
      "test/**",
      "**/*.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|mjs|txt)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false }
  }
}
