rules_version = '2';
service cloud.firestore {
  match /databases/{base}/documents {
    function correo() {
      return request.auth.token.email.lower();
    }
    function acceso() {
      return get(/databases/$(base)/documents/accesos/$(correo())).data;
    }
    function habilitado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(base)/documents/accesos/$(correo()))
        && acceso().rol in ['admin', 'operador'];
    }
    function admin() {
      return habilitado() && acceso().rol == 'admin';
    }
    function datos(col) {
      return col in ['meta', 'ordenes_compra', 'guias_despacho', 'cotizaciones', 'inventario',
        'movimientos', 'productos', 'precios_cotizados', 'precios_observados', 'archivos',
        'adjudicaciones', 'hojas_ruta'];
    }

    match /accesos/{c} {
      allow read: if request.auth != null && (c == correo() || admin());
      allow write: if admin();
    }

    match /historial/{id} {
      allow read: if habilitado();
      allow create: if habilitado() && request.resource.data.usuario == request.auth.token.email;
      allow update, delete: if false;
    }

    match /borrados/{id} {
      allow read: if habilitado();
      allow create, update: if habilitado() && request.resource.data._t == request.time;
      allow delete: if false;
    }

    match /documentos/{id} {
      allow read, create, update, delete: if habilitado();
    }

    match /documentos_partes/{id} {
      allow read, create, delete: if habilitado();
      allow update: if false;
    }

    match /{col}/{id} {
      allow read: if datos(col) && habilitado();
      allow create, update: if datos(col) && habilitado()
        && request.resource.data._v is int
        && request.resource.data._t == request.time
        && (resource == null || request.resource.data._v == resource.data._v + 1);
      allow delete: if datos(col) && (admin() || (habilitado()
        && !(col in ['productos', 'ordenes_compra', 'guias_despacho', 'cotizaciones'])));
    }
  }
}
